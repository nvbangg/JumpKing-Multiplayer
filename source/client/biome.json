{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": "../.."
	},
	"files": {
		"includes": ["src/**", "e2e/**", "*.ts", "*.json", "index.html"]
	},
	"overrides": [
		{
			"includes": ["index.html"],
			"linter": {
				"rules": {
					"complexity": {
						"noArguments": "off"
					}
				}
			}
		}
	]
}
