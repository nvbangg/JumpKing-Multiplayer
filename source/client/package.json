{
	"name": "jumpking-client",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite",
		"check": "biome check . && tsc --noEmit",
		"check:fix": "biome check --write . && tsc --noEmit",
		"test": "vitest run",
		"build": "npm run check && vite build",
		"preview": "vite preview",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"phaser": "3.90.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.64.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "6.1.2",
		"typescript": "5.9.3",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	}
}
